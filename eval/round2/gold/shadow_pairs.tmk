fn sort_asc(a: [int], least: int, most: int) -> [int]
  requires a.len <= 1_000_000
  requires forall i in 0..a.len: least <= a[i] && a[i] <= most
  ensures result.len == a.len
  ensures forall i in 0..result.len: least <= result[i] && result[i] <= most
{
  let n = a.len
  var src = a
  var dst = a
  var width = 1
  while width < n
    invariant 1 <= width && width <= 2_000_000
    invariant src.len == n && dst.len == n
    invariant forall t in 0..n: least <= src[t] && src[t] <= most
    invariant forall t in 0..n: least <= dst[t] && dst[t] <= most
  {
    var lo = 0
    while lo < n
      invariant 0 <= lo && lo <= n && dst.len == n
      invariant forall t in 0..n: least <= dst[t] && dst[t] <= most
    {
      var mid = lo + width
      if mid > n { mid = n }
      var hi = lo + 2 * width
      if hi > n { hi = n }
      var x = lo
      var y = mid
      for k in lo..hi
        invariant x + y == k + mid && lo <= x && x <= mid && mid <= y && y <= hi
        invariant forall t in 0..n: least <= dst[t] && dst[t] <= most
      {
        if y >= hi || (x < mid && src[x] <= src[y]) {
          dst[k] = src[x]
          x += 1
        } else {
          dst[k] = src[y]
          y += 1
        }
      }
      lo = hi
    }
    let t = src
    src = dst
    dst = t
    width = width * 2
  }
  src
}

// c[x] for x in lo..hi becomes min(c[x], cap).
fn settle(c: [int], lo: int, hi: int, cap: int) -> [int]
  requires 0 <= lo && lo <= hi && hi <= c.len
  requires forall t in 0..c.len: -2 <= c[t] && c[t] <= 2_000_000_000
  requires -2 <= cap && cap <= 2_000_000_000
  ensures result.len == c.len
  ensures forall t in 0..result.len: -2 <= result[t] && result[t] <= 2_000_000_000
{
  var d = c
  for x in lo..hi
    invariant d.len == c.len
    invariant forall t in 0..d.len: -2 <= d[t] && d[t] <= 2_000_000_000
  {
    if d[x] > cap { d[x] = cap }
  }
  d
}

// [largest, strictly second largest, how many equal the largest] of c[lo..hi], -2 for none.
fn block_stats(c: [int], lo: int, hi: int) -> [int]
  requires 0 <= lo && lo <= hi && hi <= c.len && hi - lo <= 256
  requires forall t in 0..c.len: -2 <= c[t] && c[t] <= 2_000_000_000
  ensures result.len == 3
  ensures -2 <= result[0] && result[0] <= 2_000_000_000 && -2 <= result[1] && result[1] <= 2_000_000_000
  ensures 0 <= result[2] && result[2] <= 256
{
  var m1 = -2
  var m2 = -2
  var k = 0
  for x in lo..hi
    invariant -2 <= m1 && m1 <= 2_000_000_000 && -2 <= m2 && m2 <= 2_000_000_000
    invariant 0 <= k && k <= x - lo
  {
    if c[x] > m1 {
      m2 = m1
      m1 = c[x]
      k = 1
    } else if c[x] == m1 {
      k += 1
    } else if c[x] > m2 {
      m2 = c[x]
    }
  }
  [m1, m2, k]
}

// c[i] is the smallest value above nums[i] seen after i (none: 2e9; i not seen yet: -1). Position j
// pairs with every seen i where nums[i] < nums[j] <= c[i], and then those c[i] become nums[j]. The
// i are kept in value order in blocks of 256 that know their largest c, the strictly second
// largest and how many share the largest, so a block whose second largest is below nums[j] is
// updated whole with a pending cap; a block is rebuilt only when two of its values merge.
pub fn shadow_pairs(nums: [int]) -> int
  requires 3 <= nums.len && nums.len <= 50_000
  requires forall i in 0..nums.len: 1 <= nums[i] && nums[i] <= 1_000_000_000
{
  let n = nums.len
  let none = 2_000_000_000
  var packed = [0; n]
  for i in 0..n {
    packed[i] = nums[i] * 65_536 + i
  }
  let keys = sort_asc(packed, 0, 65_536_000_065_535)
  var rank = [0; n]
  var sorted = [0; n]
  for r in 0..n
    invariant rank.len == n && sorted.len == n
    invariant forall t in 0..n: 0 <= rank[t] && rank[t] < n
  {
    let i = keys[r] % 65_536
    if i < n { rank[i] = r }
    sorted[r] = keys[r] / 65_536
  }
  let blocks = (n + 255) / 256
  var c = [-1; n]
  var cap = [none; blocks]
  var mx = [-1; blocks]
  var se = [-2; blocks]
  var cm = [0; blocks]
  for b in 0..blocks
    invariant cm.len == blocks
    invariant forall t in 0..blocks: 0 <= cm[t] && cm[t] <= 256
  {
    var hi = (b + 1) * 256
    if hi > n { hi = n }
    cm[b] = hi - b * 256
  }
  var count = 0
  for j in 0..n
    invariant c.len == n && cap.len == blocks && mx.len == blocks && se.len == blocks && cm.len == blocks
    invariant forall t in 0..n: -2 <= c[t] && c[t] <= 2_000_000_000
    invariant forall t in 0..blocks: -2 <= cap[t] && cap[t] <= 2_000_000_000
    invariant forall t in 0..blocks: -2 <= mx[t] && mx[t] <= 2_000_000_000
    invariant forall t in 0..blocks: -2 <= se[t] && se[t] <= 2_000_000_000
    invariant forall t in 0..blocks: 0 <= cm[t] && cm[t] <= 256
    invariant 0 <= count && count <= 60_000 * j
  {
    let v = nums[j]
    var lo = 0
    var hi = n
    while lo < hi
      invariant 0 <= lo && lo <= hi && hi <= n
    {
      let mid = lo + (hi - lo) / 2
      if sorted[mid] < v { lo = mid + 1 } else { hi = mid }
    }
    let lim = lo
    var b = 0
    while b * 256 < lim
      invariant 0 <= b && b * 256 <= lim + 255
      invariant c.len == n && cap.len == blocks && mx.len == blocks && se.len == blocks && cm.len == blocks
      invariant forall t in 0..n: -2 <= c[t] && c[t] <= 2_000_000_000
      invariant forall t in 0..blocks: -2 <= cap[t] && cap[t] <= 2_000_000_000
      invariant forall t in 0..blocks: -2 <= mx[t] && mx[t] <= 2_000_000_000
      invariant forall t in 0..blocks: -2 <= se[t] && se[t] <= 2_000_000_000
      invariant forall t in 0..blocks: 0 <= cm[t] && cm[t] <= 256
      invariant 0 <= count && count <= 60_000 * j + 256 * b
    {
      let start = b * 256
      var end = start + 256
      if end > n { end = n }
      if end <= lim && mx[b] < v {
      } else if end <= lim && se[b] < v {
        count += cm[b]
        cap[b] = v
        mx[b] = v
      } else {
        c = settle(c, start, end, cap[b])
        cap[b] = none
        var stop = end
        if stop > lim { stop = lim }
        for x in start..stop
          invariant c.len == n
          invariant forall t in 0..n: -2 <= c[t] && c[t] <= 2_000_000_000
          invariant 0 <= count && count <= 60_000 * j + 256 * b + x - start
        {
          if c[x] >= v {
            count += 1
            c[x] = v
          }
        }
        let st = block_stats(c, start, end)
        mx[b] = st[0]
        se[b] = st[1]
        cm[b] = st[2]
      }
      b += 1
    }
    let r = rank[j]
    let rb = r / 256
    var end = rb * 256 + 256
    if end > n { end = n }
    c = settle(c, rb * 256, end, cap[rb])
    cap[rb] = none
    c[r] = none
    let st = block_stats(c, rb * 256, end)
    mx[rb] = st[0]
    se[rb] = st[1]
    cm[rb] = st[2]
  }
  count
}
